# Copia aquest fitxer a ".env" al servidor i omple els valors reals.

# Clau secreta de Stripe (Dashboard → Developers → API keys)
STRIPE_SECRET_KEY=sk_live_xxxxxxxxxxxxxxxx

# Signing secret del webhook de Stripe (Dashboard → Developers → Webhooks → el teu endpoint)
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxx

# Credencials del panell d'administració (/admin) — tria'n unes de pròpies
ADMIN_USER=admin
ADMIN_PASSWORD=canvia-aquesta-contrasenya
